{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/proteger_tests.py\"",
            "statusMessage": "Hook: verificando archivos protegidos..."
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/verificar_push.py\"",
            "timeout": 300,
            "statusMessage": "Hook: ejecutando pruebas antes del push..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/ejecutar_tests.py\"",
            "timeout": 300,
            "statusMessage": "Hook: ejecutando las 5 pruebas..."
          }
        ]
      }
    ]
  }
}
